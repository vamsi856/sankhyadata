# SankhyaData marketing site, on the dedicated Hetzner server (project "sankhyadata").
# Pulled from the repo's "live" release and installed to /etc/caddy/sites/sankhyadata.caddy.
# The server's main Caddyfile only imports this file, so the global options below come first.

{
	# Contact for certificate expiry notices; also enables ZeroSSL as the fallback CA
	# when Let's Encrypt is unavailable.
	email contact@sankhyadata.com
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

sankhyadata.com {
	root * /var/www/sankhyadata/current
	encode zstd gzip
	import security_headers
	file_server

	# Hashed build files never change; fonts, media and icons may be replaced under the same name.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@static path /fonts/* /media/* /brand/* /og/* /favicon.svg /favicon.ico /apple-touch-icon.png /icon-192.png /icon-512.png
	header @static Cache-Control "public, max-age=604800"
	@manifest path /site.webmanifest
	header @manifest Content-Type "application/manifest+json"
	@html path / /index.html /privacy/ /privacy/index.html
	header @html Cache-Control "no-cache"

	# Missing paths get the styled 404 page, with the same security headers.
	handle_errors 404 {
		root * /var/www/sankhyadata/current
		import security_headers
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}

www.sankhyadata.com {
	import security_headers
	redir https://sankhyadata.com{uri} permanent
}

# The portal and its samples viewer run on the portal server, which trusts forwarded
# client addresses from this server (5.161.223.5) for these names, so per-visitor rate
# limits keep working. Caddy sends X-Forwarded-For/-Proto automatically.
(portal_proxy) {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy {args[0]} {
		header_up Host {upstream_hostport}
		header_up X-Forwarded-Host {host}
	}
}

samples.sankhyadata.com {
	import portal_proxy https://samples.egocentric.duckdns.org
}

portal.sankhyadata.com {
	import portal_proxy https://egocentric.duckdns.org
}
